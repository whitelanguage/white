// Test: FLOAT_ROUNDING
// File: tests/language/types/test_float_rounding.wl
// Focus: Nearest-even literal rounding, subnormals, and direct Float32 rounding.

func bits64(value: Float) -> UInt64 {
    let ptr bits: UInt64 = AnyPtr(ref value);
    return deref bits;
}

func bits32(value: Float32) -> UInt32 {
    let ptr bits: UInt32 = AnyPtr(ref value);
    return deref bits;
}

func main() -> Int {
    if (bits64(170141183460469231731687303715884105728.0) != 0x47e0000000000000UL) { print("FAIL: Float rounding 0"); return 1; }
    if (bits64(1.00000000000000011102230246251565404236316680908203125) != 0x3ff0000000000000UL) { print("FAIL: Float rounding 1"); return 1; }
    if (bits64(1.000000000000000111022302462515654042363166809082031251) != 0x3ff0000000000001UL) { print("FAIL: Float rounding 2"); return 1; }
    if (bits64(1.00000000000000033306690738754696212708950042724609375) != 0x3ff0000000000002UL) { print("FAIL: Float rounding 3"); return 1; }
    if (bits64(0.) != 0x0000000000000001UL) { print("FAIL: Float rounding 4"); return 1; }
    if (bits64(0.) != 0x0000000000000000UL) { print("FAIL: Float rounding 5"); return 1; }
    if (bits64(1.) != 0x3ff0000000000001UL) { print("FAIL: Float rounding 6"); return 1; }
    if (bits32(1.000000059604644775390625f) != 0x3f800000U) { print("FAIL: Float32 rounding 0"); return 1; }
    if (bits32(1.00000005960464477539062500000001f) != 0x3f800001U) { print("FAIL: Float32 rounding 1"); return 1; }
    if (bits32(1.000000178813934326171875f) != 0x3f800002U) { print("FAIL: Float32 rounding 2"); return 1; }
    if (bits32(0.000000000000000000000000000000000000000000001f) != 0x00000001U) { print("FAIL: Float32 rounding 3"); return 1; }
    print("PASS: decimal float rounding");
    return 0;
}
